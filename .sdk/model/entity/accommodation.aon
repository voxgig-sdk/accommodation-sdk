# Entity: accommodation

main: kit: entity: accommodation: {

  alias: field: {}

  fields: [
    {
      name: "AccoDetail"
      req: false
      short: "Detailed information about the accommodation"
      type: "`$OBJECT`"
    }
    {
      name: "AccoTypeId"
      req: false
      short: "Type identifier (e.g., hotel, guesthouse)"
      type: "`$STRING`"
    }
    {
      name: "Active"
      req: false
      short: "Whether the accommodation is active"
      type: "`$BOOLEAN`"
    }
    {
      name: "ContactInfos"
      req: false
      short: "Contact information"
      type: "`$OBJECT`"
    }
    {
      name: "Features"
      req: false
      short: "List of features and amenities"
      type: "`$ARRAY`"
    }
    {
      name: "GpsInfo"
      req: false
      short: "GPS coordinates"
      type: "`$ARRAY`"
    }
    {
      name: "Id"
      req: false
      short: "Unique identifier for the accommodation"
      type: "`$STRING`"
    }
    {
      format: "date-time"
      name: "LastChange"
      req: false
      short: "Last modification timestamp"
      type: "`$STRING`"
    }
    {
      name: "LocationInfo"
      req: false
      short: "Geographic location information"
      type: "`$OBJECT`"
    }
    {
      name: "Shortname"
      req: false
      short: "Short name of the accommodation"
      type: "`$STRING`"
    }
  ]

  name: "accommodation"
  op: {
    list: {
      name: "list"
      points: [
        {
          args: {
            query: [
              {
                kind: "query"
                name: "active"
                orig: "active"
                reqd: false
                type: "`$BOOLEAN`"
              }
              {
                kind: "query"
                name: "field"
                orig: "field"
                reqd: false
                type: "`$STRING`"
              }
              {
                kind: "query"
                name: "langfilter"
                orig: "langfilter"
                reqd: false
                type: "`$STRING`"
              }
              {
                kind: "query"
                name: "locfilter"
                orig: "locfilter"
                reqd: false
                type: "`$STRING`"
              }
              {
                kind: "query"
                name: "odhactive"
                orig: "odhactive"
                reqd: false
                type: "`$BOOLEAN`"
              }
              {
                example: 1
                kind: "query"
                name: "pagenumber"
                orig: "pagenumber"
                reqd: false
                type: "`$INTEGER`"
              }
              {
                example: 10
                kind: "query"
                name: "pagesize"
                orig: "pagesize"
                reqd: false
                type: "`$INTEGER`"
              }
              {
                kind: "query"
                name: "searchfilter"
                orig: "searchfilter"
                reqd: false
                type: "`$STRING`"
              }
              {
                kind: "query"
                name: "seed"
                orig: "seed"
                reqd: false
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/Accommodation"
          segments: [
            {
              lit: "Accommodation"
            }
          ]
          select: {
            exist: [
              "active"
              "field"
              "langfilter"
              "locfilter"
              "odhactive"
              "pagenumber"
              "pagesize"
              "searchfilter"
              "seed"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body.Items`"
          }
        }
      ]
    }
  }



}
